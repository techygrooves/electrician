# Bright Flow Services — Apache config (Hostinger and other Apache/LiteSpeed hosts)

ErrorDocument 404 /404.html
DirectoryIndex index.html

# Renamed service pages (keep old links working)
<IfModule mod_alias.c>
  Redirect 301 /services/panel-upgrades.html /services/electrical-panel-upgrades.html
  Redirect 301 /services/generator-installation.html /services/backup-generator-installation.html
  Redirect 301 /services/lighting-fan-installation.html /services/lighting-and-fan-upgrades.html
  Redirect 301 /services/commercial-wiring.html /services/new-construction-wiring.html
  Redirect 301 /services/electrical-troubleshooting.html /services/commercial-troubleshooting-repairs.html
</IfModule>

# Force HTTPS (uncomment once SSL is active on the domain)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
