# Bright Flow Services — Apache config (Hostinger and other Apache/LiteSpeed hosts)

ErrorDocument 404 /404.html
DirectoryIndex index.html

# Renamed service pages (keep old links working)
<IfModule mod_alias.c>
  Redirect 301 /services/panel-upgrades.html /services/electrical-panel-upgrades.html
  Redirect 301 /services/generator-installation.html /services/backup-generator-installation.html
  Redirect 301 /services/lighting-fan-installation.html /services/lighting-and-fan-upgrades.html
  Redirect 301 /services/commercial-wiring.html /services/new-construction-wiring.html
  Redirect 301 /services/electrical-troubleshooting.html /services/commercial-troubleshooting-repairs.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical homepage URL: /index.html -> /  (canonical tags already point to /)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Once the domain and SSL are live, uncomment ONE host rule so every page has a
  # single URL (https + www, matching the canonical tags). Replace example.com.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\.example\.com$ [NC]
  # RewriteRule ^ https://www.example.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Development files are not part of the public site
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(tools/|docs/|README\.md)
  RedirectMatch 404 /\.(git|github|env)
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Only this site's own files may load; forms may post to Formspree only.
  # If you add a third-party service later (analytics, chat, maps), add its domain here.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>
